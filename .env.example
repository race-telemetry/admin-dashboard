# ==========================================================================
#  Dashboard Admin — konfigurasi build
#  Salin ke .env bila perlu. Semua variabel harus diawali VITE_.
# ==========================================================================

# Alamat API Cloud Bridge.
# KOSONGKAN bila dashboard dan API berada di domain yang SAMA (disarankan) —
# nginx yang mem-proxy /api, sehingga CORS tidak diperlukan.
#
# Isi hanya bila dashboard ditaruh di domain BERBEDA dari API
# (dan CORS harus diaktifkan di server):
# VITE_API_BASE=https://bridge.domain.com
